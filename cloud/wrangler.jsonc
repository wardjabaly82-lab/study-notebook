{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-notebook",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "keep_vars": true,
  // Google sign-in: the client ID is public; the secret is a Cloudflare secret (GOOGLE_CLIENT_SECRET).
  "vars": { "GOOGLE_CLIENT_ID": "855333541492-khm5pn5ijtprmng8o0tdq19d5dbcm2n3.apps.googleusercontent.com" },
  "d1_databases": [{ "binding": "DB", "database_name": "study-notebook" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Rate limits (per minute): see src/limits.js
  "ratelimits": [
    { "name": "RL_USER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_IP", "namespace_id": "1002", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "build": { "command": "node ../scripts/build-web.js", "watch_dir": ["../renderer", "landing"] },
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true }
}
